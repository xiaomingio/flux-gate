      <% for (const field of [{name:'current',label:ui.currentPassword,autocomplete:'current-password'}, {name:'new_pass',label:ui.newPassword,autocomplete:'new-password'}, {name:'confirm',label:ui.confirmPassword,autocomplete:'new-password'}]) { %>
      <div><label for="settings-<%= field.name %>" class="mb-2 block text-sm font-medium text-slate-700"><%= field.label %></label><input id="settings-<%= field.name %>" name="<%= field.name %>" type="password" autocomplete="<%= field.autocomplete %>" required class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-base outline-none focus:border-sky-500 focus:ring-4 focus:ring-sky-500/10"></div>
      <% } %>
      <div id="settings-msg" role="status" class="text-sm text-red-700"></div>
      <button id="settings-submit" type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-slate-950 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"><%= ui.settingsSave %></button>
