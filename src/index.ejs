<% /* 文件说明: 管理 HTTP 与 TCP 路由，提供类型相关字段、运行状态和安全操作反馈。 */ %>
<!DOCTYPE html>
<html lang="<%= ui.htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title><%= ui.projectName %> · <%= ui.proxyManager %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
          },
          boxShadow: {
            soft: '0 0 0 1px rgba(15,23,42,0.06), 0 10px 30px rgba(15,23,42,0.08)',
            card: '0 0 0 1px rgba(15,23,42,0.06), 0 4px 16px rgba(15,23,42,0.06)',
          },
        },
      },
    };
  </script>
  <style>
    #f-port { appearance: textfield; -moz-appearance: textfield; }
    #f-port::-webkit-inner-spin-button,
    #f-port::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <header class="mb-6 flex flex-col gap-4 rounded-3xl border border-slate-200/70 bg-white/90 p-4 shadow-soft backdrop-blur sm:p-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <%= ui.heroBadge %>
        </div>
        <div class="mt-4 flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-900 text-lg text-white shadow-lg shadow-slate-900/10">⚡</div>
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.24em] text-slate-400"><%= ui.dashboardTitle %></p>
            <h1 class="text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl"><%= ui.projectName %></h1>
          </div>
        </div>
        <p class="mt-4 text-xl font-semibold tracking-tight text-slate-900 sm:text-2xl"><%= ui.heroSubtitle %></p>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 sm:text-base"><%= ui.heroDescription %></p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-end">
        <a href="<%= languageSwitchHref %>" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">🌍 <%= ui.switchLanguage %></a>
        <a href="/settings<%= lang === 'en' ? '?lang=en' : '' %>" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-900 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-slate-900/10 transition hover:bg-slate-800">⚙️ <%= ui.settings %></a>
      </div>
    </header>

    <main class="grid gap-6 min-w-0 xl:grid-cols-[1.35fr_0.95fr]">
      <section class="min-w-0 rounded-3xl border border-slate-200/70 bg-white p-5 shadow-soft sm:p-6">
        <div class="mb-5">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-2xl font-semibold tracking-tight text-slate-950"><%= ui.allRoutes %></h2>
            <div class="flex flex-wrap gap-2 text-xs font-medium">
              <span id="route-count-badge" class="rounded-full bg-slate-100 px-3 py-1 text-slate-600"></span>
              <span id="enabled-count-badge" class="rounded-full bg-emerald-100 px-3 py-1 text-emerald-700"></span>
            </div>
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-500"><%= ui.routeListDescription %></p>
        </div>
        <div id="tunnel-panel" class="mb-5 rounded-2xl border border-slate-200 bg-slate-50 p-4" aria-live="polite"></div>
        <div id="route-list"></div>
      </section>

      <section class="min-w-0 rounded-3xl border border-slate-200/70 bg-slate-950 p-5 text-slate-50 shadow-soft sm:p-6">
        <div class="mb-5">
          <h2 id="route-form-title" class="text-2xl font-semibold tracking-tight"><%= ui.addRoute %></h2>
          <p id="route-form-subtitle" class="mt-2 text-sm leading-6 text-slate-300"><%= ui.addPanelDescription %></p>
        </div>

        <form class="grid min-w-0 gap-4" onsubmit="saveRoute(event)">
          <input type="hidden" id="f-original-subdomain">

          <fieldset class="min-w-0">
            <legend class="mb-2 block text-sm font-medium text-slate-200"><%= ui.routeMode %></legend>
            <div class="flex gap-1.5 rounded-2xl border border-slate-700 bg-slate-900/70 p-1.5">
              <label class="min-w-0 flex-1 cursor-pointer">
                <input type="radio" name="route_mode" id="f-mode-protected" value="protected" checked class="peer sr-only">
                <span class="block rounded-xl px-2 py-2.5 text-center text-sm font-semibold leading-5 text-slate-300 transition hover:bg-slate-800 peer-checked:bg-white peer-checked:text-slate-950 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-400"><span class="block">HTTP</span><span class="block text-xs"><%= ui.passwordProtection %></span></span>
              </label>
              <label class="min-w-0 flex-1 cursor-pointer">
                <input type="radio" name="route_mode" id="f-mode-http-direct" value="http-direct" class="peer sr-only">
                <span class="block rounded-xl px-2 py-2.5 text-center text-sm font-semibold leading-5 text-slate-300 transition hover:bg-slate-800 peer-checked:bg-white peer-checked:text-slate-950 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-400"><span class="block">HTTP</span><span class="block text-xs"><%= ui.directConnection %></span></span>
              </label>
              <label class="min-w-0 flex-1 cursor-pointer">
                <input type="radio" name="route_mode" id="f-mode-tcp-direct" value="tcp-direct" class="peer sr-only">
                <span class="block rounded-xl px-2 py-2.5 text-center text-sm font-semibold leading-5 text-slate-300 transition hover:bg-slate-800 peer-checked:bg-white peer-checked:text-slate-950 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-400"><span class="block">TCP</span><span class="block text-xs"><%= ui.directConnection %></span></span>
              </label>
            </div>
          </fieldset>
          <div id="route-flow" class="grid min-w-0 gap-2">
            <div class="min-w-0 rounded-2xl border border-slate-700 bg-slate-900/60 p-3">
              <label for="f-sub" class="mb-2 block text-sm font-medium text-slate-200"><%= ui.publicAddress %></label>
            <div class="flex min-w-0 items-baseline">
              <span id="f-sub-scheme" class="inline-flex shrink-0 items-center px-3 text-sm font-medium text-slate-400" aria-hidden="true">https://</span>
              <input name="subdomain" id="f-sub" placeholder="nas" required class="min-w-0 flex-1 border-x-0 border-t-0 border-b border-slate-600 bg-transparent px-3 pt-1 pb-0.5 text-base text-white placeholder:text-slate-500 outline-none focus:border-sky-400 focus:ring-0">
              <span class="inline-flex shrink-0 items-center px-4 text-sm font-medium text-slate-400">.<%= baseDomain %></span>
            </div>
            </div>
            <div class="text-center text-slate-500" aria-hidden="true">↓</div>
            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 px-3 py-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2 text-sm"><span class="font-medium">Cloudflare</span><span id="cloudflare-access-note" class="text-xs text-slate-400"><%= ui.cloudflareHttp %></span></div>
            </div>
            <div class="text-center text-slate-500" aria-hidden="true">↓</div>
            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 px-3 py-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2 text-sm"><span class="font-medium">Cloudflare Tunnel</span><span class="text-xs text-slate-400"><%= ui.tunnelEncryption %></span></div>
            </div>
            <fieldset id="http-auth-fields" class="grid min-w-0 gap-2 text-sm text-slate-200">
              <legend class="sr-only"><%= ui.passwordProtection %></legend>
              <div class="text-center text-slate-500" aria-hidden="true">↓</div>
              <div id="gate-node" class="grid min-w-0 gap-3 rounded-2xl border border-sky-500/40 bg-sky-500/10 p-3">
                <div class="flex flex-wrap items-center justify-between gap-2"><span class="font-medium">Gate</span><span class="rounded-full bg-sky-500/15 px-2 py-1 text-xs text-sky-200"><%= ui.passwordProtection %></span></div>
                <div class="grid gap-3">
                  <label class="flex items-start gap-3">
                    <input type="radio" id="auth-mode-default" name="auth_mode" value="default" checked class="h-4 w-4 border-slate-600 bg-slate-800 text-sky-500 focus:ring-sky-400/20">
                    <span><%= ui.authDefaultFormLabel %></span>
                  </label>
                  <label class="flex items-start gap-3">
                    <input type="radio" id="auth-mode-custom" name="auth_mode" value="custom" class="h-4 w-4 border-slate-600 bg-slate-800 text-sky-500 focus:ring-sky-400/20">
                    <span><%= ui.authCustomLabel %></span>
                  </label>
                </div>
            <div id="custom-auth-fields" class="hidden grid gap-4 sm:grid-cols-2">
              <div>
                <label for="f-username" class="mb-2 block text-sm font-medium text-slate-200"><%= ui.customUsername %></label>
                <input name="username" id="f-username" autocomplete="off" disabled placeholder="alice" class="w-full rounded-2xl border border-slate-700 bg-slate-900/70 px-4 py-3 text-base text-white placeholder:text-slate-500 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-400/15">
              </div>
              <div>
                <label for="f-password" class="mb-2 block text-sm font-medium text-slate-200"><%= ui.customPassword %></label>
                <input name="password" id="f-password" type="password" autocomplete="new-password" disabled placeholder="••••••••" class="w-full rounded-2xl border border-slate-700 bg-slate-900/70 px-4 py-3 text-base text-white placeholder:text-slate-500 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-400/15">
              </div>
            </div>
              </div>
            </fieldset>
            <div class="text-center text-slate-500" aria-hidden="true">↓</div>
            <div class="min-w-0 rounded-2xl border border-slate-700 bg-slate-900/60 p-3">
              <p class="mb-2 text-sm font-medium"><%= ui.targetAddress %></p>
            <div class="sr-only">
              <label for="f-ip"><%= ui.targetIp %></label>
              <label for="f-port"><%= ui.port %></label>
            </div>
            <div class="flex min-w-0 items-baseline">
              <span id="f-target-scheme" class="inline-flex shrink-0 items-center px-3 text-sm font-medium text-slate-400" aria-hidden="true">http://</span>
              <input name="ip" id="f-ip" placeholder="<%= ui.targetHostPlaceholder %>" required class="min-w-0 flex-1 border-x-0 border-t-0 border-b border-slate-600 bg-transparent px-3 pt-1 pb-0.5 text-base text-white placeholder:text-slate-500 outline-none focus:border-sky-400 focus:ring-0">
              <span class="inline-flex shrink-0 items-center px-2 text-slate-400" aria-hidden="true">:</span>
              <input name="port" id="f-port" type="number" min="1" max="65535" step="1" placeholder="8080" required class="w-20 min-w-0 shrink-0 border-x-0 border-t-0 border-b border-slate-600 bg-transparent px-3 pt-1 pb-0.5 text-base text-white placeholder:text-slate-500 outline-none focus:border-sky-400 focus:ring-0">
            </div>
            </div>
          </div>
          <div class="min-w-0">
            <label for="f-desc" class="mb-2 block text-sm font-medium text-slate-200"><%= ui.descriptionOptional %></label>
            <input name="description" id="f-desc" placeholder="<%= ui.descriptionPlaceholder %>" class="w-full min-w-0 rounded-2xl border border-slate-700 bg-slate-900/70 px-3 py-3 text-base text-white placeholder:text-slate-500 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-400/15">
          </div>
          <p id="no-password-warning" role="note" class="hidden rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm leading-6 text-red-300"><%= ui.noPasswordWarning %></p>
          <p id="tcp-security-warning" role="note" class="hidden rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm leading-6 text-red-300"><%= ui.tcpSecurityWarning %></p>
          <label class="flex items-start gap-3 rounded-2xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm text-slate-200">
            <input type="checkbox" id="f-enabled" name="enabled" checked class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-sky-500 focus:ring-sky-400/20">
            <span><%= ui.startRouteLabel %></span>
          </label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <button id="route-submit-button" type="submit" class="inline-flex items-center justify-center rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"><%= ui.add %></button>
            <button id="route-cancel-button" type="button" onclick="resetRouteForm()" class="hidden inline-flex items-center justify-center rounded-2xl border border-slate-700 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-900"><%= ui.cancelEdit %></button>
          </div>
        </form>

        <div id="form-msg" role="status" aria-live="polite" class="mt-4"></div>
      </section>
    </main>
  </div>

<script>
const baseDomain = <%- JSON.stringify(baseDomain).replace(/</g, '\\u003c') %>;
const ui = <%- JSON.stringify(ui).replace(/</g, '\\u003c') %>;
const routes = <%- JSON.stringify(routes).replace(/</g, '\\u003c') %>;
let mutationPending = false;
let tunnelState = null;
let unconfirmedOperation = null;
let failedMutation = null;

function renderTunnelStatus() {
  const panel = document.getElementById('tunnel-panel');
  const state = tunnelState;
  const existingOpen = document.getElementById('existing-tunnel-rules')?.open || false;
  const status = mutationPending && !unconfirmedOperation ? ui.routeSyncing : !state ? ui.tunnelLoading : ({ disabled: ui.tunnelManual, pending: ui.tunnelPending, applied: ui.tunnelApplied, error: ui.tunnelError })[state.status] || ui.tunnelError;
  panel.innerHTML = `<div class="flex flex-wrap items-center justify-between gap-3"><h3 class="font-semibold text-slate-900">${ui.tunnelTitle}</h3><span class="text-sm ${state?.status === 'error' ? 'text-red-700' : 'text-slate-600'}">${status}</span></div>
    ${state?.changes?.length ? `<ul class="mt-3 grid gap-3 text-xs text-slate-700">${state.changes.filter(change => change.status !== 'applied' && change.status !== 'disabled').map(change => `<li class="grid gap-1 border-t border-slate-200 pt-2"><span class="break-all font-medium">${escapeHtml(formatPublicAddress(change.hostname, change.desired_service, true))}</span><span class="break-all">${ui.currentPath}: ${escapeHtml(state.current_verified ? change.current_service || pathLabel(change.current_path) : ui.currentUnknown)}</span><span class="break-all text-amber-800">${ui.desiredPath}: ${escapeHtml(change.desired_service || pathLabel(change.desired_path))}</span></li>`).join('')}</ul>` : ''}
    ${state ? renderExistingRules(state, existingOpen) : ''}
    ${state?.error ? `<p class="mt-3 break-words text-sm text-red-700">${escapeHtml(state.error)}</p>` : ''}
    ${state?.status === 'disabled' ? `<p class="mt-3 text-sm leading-6 text-slate-600">${ui.tunnelManualHint}</p>` : ''}
    <button type="button" id="tunnel-refresh-button" class="mt-3 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500">${ui.refreshStatus}</button>`;
  document.getElementById('tunnel-refresh-button').addEventListener('click', refreshPublicationStatus);
}

function renderExistingRules(state, open) {
  const inventories = Array.isArray(state.inventories) ? state.inventories : [];
  const rules = inventories.flatMap(inventory => inventory.existing_rules || []);
  const count = ui.existingRulesCount.replace('{count}', String(rules.length)).replace('{external}', String(rules.filter(rule => !rule.managed).length));
  const groups = inventories.map(inventory => {
    const title = inventory.kind === 'management' ? ui.managementTunnel : ui.forwardingTunnel;
    const entries = Array.isArray(inventory.existing_rules) ? inventory.existing_rules : [];
    const content = inventory.existing_rules_error
      ? `<p class="mt-2 break-words text-sm text-red-700">${escapeHtml(inventory.existing_rules_error)}</p>`
      : `<p class="mt-2 text-xs leading-5 text-slate-500">${inventory.current_verified ? ui.configurationVerified : ui.configurationUnverified}</p>${entries.length ? `<ul class="existing-tunnel-rule-list mt-3 grid gap-2">${entries.map(rule => `<li data-managed="${Boolean(rule.managed && !inventory.read_only)}" class="min-w-0 rounded-xl border border-slate-200 bg-white px-3 py-2.5"><div class="flex flex-wrap items-start justify-between gap-2"><span class="min-w-0 break-all font-mono text-xs font-medium text-slate-800">${escapeHtml(formatPublicAddress(rule.hostname, rule.service, rule.managed && !inventory.read_only))}</span><span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium ${rule.managed && !inventory.read_only ? 'bg-sky-50 text-sky-700' : 'bg-slate-100 text-slate-600'}">${rule.managed && !inventory.read_only ? ui.gateManaged : ui.externallyMaintained}</span></div>${rule.path ? `<p class="mt-1 break-all font-mono text-xs text-slate-500">${ui.rulePath}: ${escapeHtml(rule.path)}</p>` : ''}<p class="mt-1 break-all font-mono text-xs leading-5 text-slate-700">→ ${escapeHtml(rule.service)}</p></li>`).join('')}</ul>` : `<p class="mt-2 text-sm text-slate-500">${ui.noExistingRules}</p>`}`;
    return `<section data-inventory-kind="${inventory.kind === 'management' ? 'management' : 'forwarding'}" class="min-w-0 border-t border-slate-200 pt-3"><h4 class="flex flex-wrap items-baseline gap-2 text-sm font-semibold text-slate-800">${title}</h4>${content}</section>`;
  }).join('');
  return `<details id="existing-tunnel-rules" class="mt-3 border-t border-slate-200 pt-3"${open ? ' open' : ''}><summary class="cursor-pointer rounded text-sm font-medium text-slate-700 outline-none focus-visible:ring-2 focus-visible:ring-sky-500">${ui.existingRulesTitle}<span class="ml-2 text-xs font-normal text-slate-500">${escapeHtml(count)}</span></summary><div class="mt-3 grid gap-4">${groups || `<p class="text-sm text-slate-500">${ui.tunnelLoadFailed}</p>`}</div><p class="mt-3 text-xs leading-5 text-slate-500">${ui.externalRulesReadOnly}</p></details>`;
}

async function loadTunnelStatus() {
  try {
    const response = await fetch('/api/tunnel');
    if (!response.ok) throw new Error(response.status === 401 ? ui.relogin : ui.tunnelLoadFailed);
    const data = await response.json();
    if (typeof data.enabled !== 'boolean' || !Array.isArray(data.rules)) throw new Error(ui.tunnelLoadFailed);
    tunnelState = data;
  } catch (error) { tunnelState = { enabled: false, status: 'error', rules: [], error: error.message || ui.tunnelLoadFailed }; }
  renderTunnelStatus();
}

function acceptPublication(data) {
  if (Array.isArray(data.routes)) routes.splice(0, routes.length, ...data.routes);
  if (data.tunnel && typeof data.tunnel.enabled === 'boolean') tunnelState = data.tunnel;
  renderRoutes();
  renderTunnelStatus();
  setMutationPending(mutationPending);
}

async function readPublication() {
  const [routeResponse, tunnelResponse] = await Promise.all([fetch('/api/routes', { cache: 'no-store' }), fetch('/api/tunnel', { cache: 'no-store' })]);
  if (routeResponse.status === 401 || tunnelResponse.status === 401) throw new Error(ui.relogin);
  if (!routeResponse.ok || !tunnelResponse.ok) throw new Error(ui.routeLoadFailed);
  const [routeData, tunnelData] = await Promise.all([routeResponse.json(), tunnelResponse.json()]);
  if (!Array.isArray(routeData) || typeof tunnelData.enabled !== 'boolean') throw new Error(ui.routeLoadFailed);
  acceptPublication({ routes: routeData, tunnel: tunnelData });
}

async function readOperation(id) {
  const response = await fetch(`/api/operations/${encodeURIComponent(id)}`, { cache: 'no-store' });
  if (response.status === 401) throw new Error(ui.relogin);
  if (response.status === 404) return null;
  if (!response.ok) throw new Error(ui.syncUnconfirmed);
  const data = await response.json();
  return data.operation?.id === id ? data.operation : null;
}

function checkOperation(operation) {
  if (operation?.status === 'applied' && operation.current === true) return;
  const message = !operation ? ui.syncUnconfirmed
    : operation.status === 'local_only' ? ui.syncLocalOnly
    : operation.status === 'rolled_back' ? ui.syncRolledBack
    : operation.status === 'applied' && operation.current !== true ? ui.syncSuperseded
    : operation.error || ui.syncUnconfirmed;
  throw Object.assign(new Error(message), { operation });
}

async function recoverOperation(id, complete, snapshot) {
  showRouteMessage(ui.syncChecking);
  for (const delay of [0, 500, 1000, 2000, 3000, 3000]) {
    if (delay) await new Promise(resolve => setTimeout(resolve, delay));
    let operation;
    try { operation = await readOperation(id); } catch { continue; }
    if (!operation || ['queued', 'running'].includes(operation.status)) continue;
    try { await readPublication(); } catch {
      unconfirmedOperation = { id, complete, snapshot };
      throw new Error(ui.syncUnconfirmed);
    }
    if (operation.status === 'unknown') unconfirmedOperation = { id, complete, snapshot };
    checkOperation(operation);
    return;
  }
  unconfirmedOperation = { id, complete, snapshot };
  throw new Error(ui.syncUnconfirmed);
}

async function refreshPublicationStatus() {
  const button = document.getElementById('tunnel-refresh-button');
  button.disabled = true;
  const pending = unconfirmedOperation;
  try {
    await readPublication();
    if (pending) {
      const operation = await readOperation(pending.id);
      if (!operation || ['queued', 'running', 'unknown'].includes(operation.status)) throw new Error(ui.syncUnconfirmed);
      unconfirmedOperation = null;
      checkOperation(operation);
      pending.complete();
    }
  } catch (error) { showMutationFailure(error, pending?.snapshot); }
  finally { setMutationPending(Boolean(unconfirmedOperation)); }
}

function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
}

function selectedMode() { return document.querySelector('input[name="route_mode"]:checked').value; }
function formRouteType() { return selectedMode() === 'tcp-direct' ? 'tcp' : 'http'; }

function routeType(route) { return route.type === 'tcp' ? 'tcp' : 'http'; }
function routeName(route) { return `${route.subdomain}.${baseDomain}`; }

function formatPublicAddress(hostname, service, managed = false) {
  if (!hostname) return ui.catchAllRule;
  const host = String(hostname).replace(/^(?:https?|tcp|ssh):\/\//i, '');
  let scheme = /^https?:\/\//i.test(service || '') ? 'https' : /^(?:tcp|ssh):\/\//i.test(service || '') ? 'tcp' : null;
  if (!scheme && managed) {
    const route = routes.find(route => routeName(route) === host);
    if (route) scheme = routeType(route) === 'tcp' ? 'tcp' : 'https';
  }
  if (scheme) return `${scheme}://${host}`;
  return service === 'http_status:404' ? `${ui.pathBlocked} · ${host}` : host;
}

function showRouteMessage(message, error = false, action) {
  const box = document.createElement('div');
  box.className = error
    ? 'rounded-2xl border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100'
    : 'rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100';
  box.textContent = message;
  if (action) {
    const button = document.createElement('button');
    button.id = 'mutation-recovery-button';
    button.type = 'button';
    button.className = 'mt-3 block rounded-xl border border-current px-3 py-2 font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-400';
    button.textContent = action.label;
    button.addEventListener('click', action.run);
    box.appendChild(button);
  }
  document.getElementById('form-msg').replaceChildren(box);
  if (error) box.scrollIntoView({ block: 'nearest' });
}

function clearFailedMutation() {
  failedMutation = null;
  if (!unconfirmedOperation) document.getElementById('mutation-recovery-button')?.remove();
}

function showMutationFailure(error, snapshot) {
  const retryable = error.operation?.status === 'rolled_back' && error.operation.rollback_confirmed === true && snapshot;
  if (retryable) {
    failedMutation = snapshot;
    document.getElementById('route-cancel-button').classList.remove('hidden');
    showRouteMessage(ui.syncRolledBack, true, { label: ui.retryOperation, run: () => {
      if (!failedMutation || mutationPending) return;
      const retry = failedMutation;
      mutateRoute(retry.url, retry.options, retry.successMessage, retry.onSuccess);
    } });
  } else if (unconfirmedOperation) {
    showRouteMessage(ui.syncUnconfirmed, true, { label: ui.verifyOperation, run: refreshPublicationStatus });
  } else { showRouteMessage(error.message || ui.routeRequestFailed, true); }
}

async function mutateRoute(url, options, successMessage, onSuccess = () => {}) {
  const id = crypto.randomUUID();
  const snapshot = { url, options, successMessage, onSuccess };
  clearFailedMutation();
  const complete = () => { clearFailedMutation(); onSuccess(); showRouteMessage(successMessage); };
  setMutationPending(true);
  renderTunnelStatus();
  setMutationPending(true);
  showRouteMessage(ui.routeSyncing);
  try {
    let response, data;
    try {
      response = await fetch(url, { ...options, headers: { ...options.headers, 'X-Flux-Gate-Operation': id } });
      data = await response.json();
    } catch {
      await recoverOperation(id, complete, snapshot);
      complete();
      return;
    }
    if (response.status >= 500 && !data.operation) {
      await recoverOperation(id, complete, snapshot);
      complete();
      return;
    }
    acceptPublication(data);
    if (response.status === 401) throw new Error(ui.relogin);
    if (!response.ok || data.error) {
      if (data.operation?.status === 'unknown') unconfirmedOperation = { id, complete, snapshot };
      throw Object.assign(new Error(data.error || ui.routeRequestFailed), { operation: data.operation });
    }
    if (data.operation?.id !== id) throw new Error(ui.syncUnconfirmed);
    checkOperation(data.operation);
    complete();
  } catch (error) { showMutationFailure(error, snapshot); }
  finally {
    setMutationPending(Boolean(unconfirmedOperation));
    renderTunnelStatus();
  }
}

function setMutationPending(pending) {
  mutationPending = pending;
  document.querySelectorAll('#route-list button, #route-submit-button, #route-cancel-button').forEach(button => { button.disabled = pending; });
  const submit = document.getElementById('route-submit-button');
  document.querySelector('form').inert = pending;
  submit.setAttribute('aria-busy', String(pending));
  submit.textContent = pending ? ui.routeSaving : document.getElementById('f-original-subdomain').value ? ui.update : ui.add;
  const refresh = document.getElementById('tunnel-refresh-button');
  if (refresh) refresh.disabled = pending && !unconfirmedOperation;
}

function toggleRouteTypeFields() {
  const tcp = formRouteType() === 'tcp';
  document.getElementById('f-sub-scheme').textContent = tcp ? 'tcp://' : 'https://';
  document.getElementById('f-sub').placeholder = tcp ? 'ssh' : 'nas';
  document.getElementById('f-target-scheme').textContent = tcp ? 'tcp://' : 'http://';
  const protectedMode = selectedMode() === 'protected';
  document.getElementById('http-auth-fields').classList.toggle('hidden', !protectedMode);
  document.getElementById('http-auth-fields').disabled = !protectedMode;
  document.getElementById('cloudflare-access-note').textContent = tcp ? ui.cloudflareTcp : ui.cloudflareHttp;
  toggleAuthModeFields();
}

function updateRouteCount() {
  const routeCountBadge = document.getElementById('route-count-badge');
  const enabledCountBadge = document.getElementById('enabled-count-badge');
  const enabledCount = routes.filter((route) => !route.disabled).length;

  if (routeCountBadge) routeCountBadge.textContent = ui.allRoutesCount.replace('{count}', String(routes.length));
  if (enabledCountBadge) enabledCountBadge.textContent = ui.enabledRoutesCount.replace('{count}', String(enabledCount));
}

function getRouteStatusLabel(route) {
  if (route.current_verified && route.current_path === 'blocked' && route.desired_path === 'blocked') return ui.routeDisabledState;
  return ({ applied: ui.publicationApplied, pending: ui.tunnelPending, disabled: ui.tunnelManual, error: ui.tunnelError })[route.publication_status] || ui.currentUnknown;
}

function getRouteStatusClass(route) {
  if (route.publication_status === 'pending') return 'border-amber-200 bg-amber-50 text-amber-700';
  if (route.publication_status === 'error') return 'border-red-200 bg-red-50 text-red-700';
  if (route.current_verified && route.current_path === 'blocked') return 'border-slate-300 bg-slate-100 text-slate-600';
  return route.current_verified ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-300 bg-slate-100 text-slate-600';
}

function pathLabel(path) {
  return ({ gateway: ui.pathGateway, direct: ui.pathDirect, blocked: ui.pathBlocked, unmanaged: ui.pathUnmanaged, unknown: ui.currentUnknown })[path] || ui.currentUnknown;
}

function renderRoutePath(route) {
  const current = route.current_verified ? route.current_path : 'unknown';
  let chain = escapeHtml(pathLabel(current));
  if (current === 'gateway' || current === 'direct') {
    const gatewayActive = current === 'gateway' && route.desired_path === 'gateway';
    const service = current === 'direct' ? route.current_service : gatewayActive ? route.target_service : ui.pathBlocked;
    chain = `<span class="block text-xs text-slate-500">Cloudflare → Cloudflare Tunnel</span>${current === 'gateway' ? `<span class="block">↓ Gate${gatewayActive ? ` · ${escapeHtml(ui.passwordProtection)}` : ''}</span>` : ''}<span class="block break-all">↓ ${escapeHtml(service)}</span>`;
  }
  const pending = route.publication_status === 'pending' || route.publication_status === 'error';
  if (current === 'unmanaged' && route.current_service) chain += `<span class="block break-all">${escapeHtml(route.current_service)}</span>`;
  const desired = route.desired_path === 'blocked' ? ui.blockPublicAccess : `${pathLabel(route.desired_path)} → ${route.target_service}`;
  return `<div class="grid gap-2"><div><p class="text-xs font-medium text-slate-500">${ui.currentPath}</p><div class="mt-1 break-all text-sm leading-6 text-slate-700">${chain}</div></div>${pending ? `<div class="border-t border-slate-200 pt-2 text-sm"><p class="text-xs font-medium text-amber-700">${ui.desiredPath}</p><p class="mt-1 break-all text-slate-700">${escapeHtml(desired)}</p>${current === 'direct' && route.desired_path === 'gateway' ? `<p class="mt-1 text-red-700">${ui.notProtectedYet}</p>` : ''}</div>` : ''}</div>`;
}

function toggleAuthModeFields() {
  const tcp = formRouteType() === 'tcp';
  const mode = document.querySelector('input[name="auth_mode"]:checked')?.value || 'default';
  document.getElementById('custom-auth-fields').classList.toggle('hidden', mode !== 'custom');
  const custom = selectedMode() === 'protected' && mode === 'custom';
  for (const id of ['f-username', 'f-password']) {
    document.getElementById(id).required = custom;
    document.getElementById(id).disabled = !custom;
  }
  document.getElementById('no-password-warning').classList.toggle('hidden', selectedMode() !== 'http-direct');
  document.getElementById('tcp-security-warning').classList.toggle('hidden', !tcp);
}

function icon(name) {
  const cls = 'h-4 w-4';
  const icons = {
    edit: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="${cls}" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 1 1 3.182 3.182L8.25 18.463 4.5 19.5l1.037-3.75L16.862 3.487Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 5.25 18.75 9" /></svg>`,
    play: `<svg viewBox="0 0 24 24" fill="currentColor" class="${cls}" aria-hidden="true"><path d="M8.25 6.75v10.5a.75.75 0 0 0 1.154.636l8.25-5.25a.75.75 0 0 0 0-1.272l-8.25-5.25A.75.75 0 0 0 8.25 6.75Z" /></svg>`,
    pause: `<svg viewBox="0 0 24 24" fill="currentColor" class="${cls}" aria-hidden="true"><path d="M6.75 5.25A.75.75 0 0 1 7.5 4.5h2.25a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H7.5a.75.75 0 0 1-.75-.75V5.25Zm6.75 0a.75.75 0 0 1 .75-.75h2.25a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1-.75-.75V5.25Z" /></svg>`,
    trash: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="${cls}" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h12" /><path stroke-linecap="round" stroke-linejoin="round" d="m9.75 7.5.375-1.5A1.125 1.125 0 0 1 11.214 5.25h1.572c.516 0 .966.35 1.089.85l.375 1.4" /><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5v9.75A2.25 2.25 0 0 0 10.5 19.5h3A2.25 2.25 0 0 0 15.75 17.25V7.5" /></svg>`,
  };
  return icons[name] || '';
}

function renderRoutes() {
  const el = document.getElementById('route-list');
  updateRouteCount();

  if (routes.length === 0) {
    el.innerHTML = `
      <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-2xl shadow-card">🚀</div>
        <p class="mt-4 text-base font-medium text-slate-900">${ui.emptyRoutes}</p>
        <p class="mt-2 text-sm text-slate-500">${ui.addPanelDescription}</p>
      </div>`;
    return;
  }

  el.innerHTML = `<div class="grid min-w-0 gap-3 md:grid-cols-2">${routes.map((r) => {
    const name = escapeHtml(routeName(r));
    const tcp = routeType(r) === 'tcp';
    const source = escapeHtml(formatPublicAddress(routeName(r), r.target_service, true));
    const title = r.disabled || tcp
      ? `<h3 class="break-all text-base font-semibold tracking-tight ${r.disabled ? 'text-slate-400' : 'text-slate-950'}">${source}</h3>`
      : `<a href="https://${name}" target="_blank" rel="noreferrer" class="mt-1 block group rounded-2xl outline-none transition focus-visible:ring-2 focus-visible:ring-sky-400/40"><h3 class="break-all text-base font-semibold tracking-tight text-slate-950 transition group-hover:text-sky-600">${source}</h3></a>`;

    return `
      <article class="w-full min-w-0 rounded-3xl border ${r.disabled ? 'border-slate-200 bg-slate-100/80' : 'border-slate-200 bg-slate-50'} p-4 shadow-card transition hover:-translate-y-0.5 hover:bg-white sm:p-5">
        <div class="flex min-w-0 flex-col gap-4 sm:flex-row sm:items-start">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-slate-400">${ui.subdomain}</p>
              <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-medium text-slate-600">${tcp ? 'TCP' : 'HTTP'}</span>
              <span class="rounded-full border px-2.5 py-1 text-[11px] font-medium ${getRouteStatusClass(r)}">${getRouteStatusLabel(r)}</span>
            </div>
            <div class="mt-1">${title}</div>
            <div class="mt-2 rounded-2xl bg-white px-3 py-3 shadow-sm">${renderRoutePath(r)}</div>
            <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">${escapeHtml(r.description || ui.noDescription)}</p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-2 sm:flex-col sm:items-end sm:justify-start sm:self-start">
            <button type="button" data-action="edit" data-subdomain="${escapeHtml(r.subdomain)}" title="${ui.editLabel}" aria-label="${ui.editLabel} ${name}" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-2xl border border-slate-200 bg-white text-sm text-slate-500 transition hover:border-sky-200 hover:bg-sky-50 hover:text-sky-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500 disabled:cursor-default disabled:opacity-50">${icon('edit')}</button>
            <button type="button" data-action="toggle" data-subdomain="${escapeHtml(r.subdomain)}" title="${r.disabled ? ui.enableLabel : ui.disableLabel}" aria-label="${r.disabled ? ui.enableLabel : ui.disableLabel} ${name}" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-2xl border border-slate-200 bg-white text-sm text-slate-500 transition hover:border-amber-200 hover:bg-amber-50 hover:text-amber-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500 disabled:cursor-default disabled:opacity-50">${icon(r.disabled ? 'play' : 'pause')}</button>
            <button type="button" data-action="delete" data-subdomain="${escapeHtml(r.subdomain)}" title="${ui.deleteLabel}" aria-label="${ui.deleteLabel} ${name}" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-2xl border border-slate-200 bg-white text-sm text-slate-500 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500 disabled:cursor-default disabled:opacity-50">${icon('trash')}</button>
          </div>
        </div>
      </article>`;
  }).join('')}</div>`;
}

function resetRouteForm() {
  clearFailedMutation();
  document.getElementById('f-mode-protected').checked = true;
  document.getElementById('f-original-subdomain').value = '';
  document.getElementById('f-sub').value = '';
  document.getElementById('f-ip').value = '';
  document.getElementById('f-port').value = '';
  document.getElementById('f-desc').value = '';
  document.getElementById('f-username').value = '';
  document.getElementById('f-password').value = '';
  document.getElementById('auth-mode-default').checked = true;
  document.getElementById('f-enabled').checked = true;
  toggleAuthModeFields();
  toggleRouteTypeFields();
  document.getElementById('route-form-title').textContent = ui.addRoute;
  document.getElementById('route-form-subtitle').textContent = ui.addPanelDescription;
  document.getElementById('route-submit-button').textContent = ui.add;
  document.getElementById('route-cancel-button').classList.add('hidden');
}

function editRoute(subdomain) {
  if (mutationPending) return;
  clearFailedMutation();
  const route = routes.find((item) => item.subdomain === subdomain);
  if (!route) return;

  document.getElementById('f-original-subdomain').value = route.subdomain;
  document.getElementById(routeType(route) === 'tcp' ? 'f-mode-tcp-direct' : route.no_password ? 'f-mode-http-direct' : 'f-mode-protected').checked = true;
  document.getElementById('f-sub').value = route.subdomain;
  document.getElementById('f-ip').value = route.ip;
  document.getElementById('f-port').value = route.port;
  document.getElementById('f-desc').value = route.description || '';
  document.getElementById('f-username').value = route.username || '';
  document.getElementById('f-password').value = '';
  if (route.has_custom_auth) document.getElementById('auth-mode-custom').checked = true;
  else document.getElementById('auth-mode-default').checked = true;
  document.getElementById('f-enabled').checked = !Boolean(route.disabled);
  toggleAuthModeFields();
  toggleRouteTypeFields();
  document.getElementById('route-form-title').textContent = ui.updateRoute;
  document.getElementById('route-form-subtitle').textContent = ui.editingRoute.replace('{route}', `${route.subdomain}.${baseDomain}`);
  document.getElementById('route-submit-button').textContent = ui.update;
  document.getElementById('route-cancel-button').classList.remove('hidden');
  document.getElementById('f-sub').focus();
}

async function saveRoute(e) {
  e.preventDefault();
  if (mutationPending) return;
  const originalSubdomain = document.getElementById('f-original-subdomain').value.trim();
  const type = formRouteType();
  const disabled = !document.getElementById('f-enabled').checked;
  const previous = routes.find(route => route.subdomain === originalSubdomain);
  if (previous && !previous.disabled && disabled && !confirm(ui.disableConfirm.replace('{route}', routeName(previous)))) return;
  const input = {
    original_subdomain: originalSubdomain,
    subdomain: document.getElementById('f-sub').value.trim(),
    type,
    ip: document.getElementById('f-ip').value.trim(),
    port: Number(document.getElementById('f-port').value),
    description: document.getElementById('f-desc').value.trim(),
    disabled,
  };
  if (type === 'http') {
    const authMode = selectedMode() === 'http-direct' ? 'none' : document.querySelector('input[name="auth_mode"]:checked')?.value || 'default';
    input.auth_mode = authMode;
    input.username = authMode === 'custom' ? document.getElementById('f-username').value.trim() : '';
    input.password = authMode === 'custom' ? document.getElementById('f-password').value.trim() : '';
    if (authMode === 'custom' && (!input.username || !input.password)) {
      showRouteMessage(ui.customCredentialsRequired, true);
      document.getElementById(!input.username ? 'f-username' : 'f-password').focus();
      return;
    }
    input.no_password = authMode === 'none';
  }
  await mutateRoute('/api/routes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(input) }, originalSubdomain ? ui.routeSavedUpdated : ui.routeSavedAdded, resetRouteForm);
}

async function toggleRouteDisabled(subdomain) {
  if (mutationPending) return;
  const route = routes.find(item => item.subdomain === subdomain);
  if (!route || (!route.disabled && !confirm(ui.disableConfirm.replace('{route}', routeName(route))))) return;
  await mutateRoute(`/api/routes/${encodeURIComponent(subdomain)}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ disabled: !route.disabled }) }, ui.routeSavedUpdated);
}

async function deleteRoute(subdomain) {
  if (mutationPending) return;
  const route = routes.find(item => item.subdomain === subdomain);
  if (!route || !confirm(ui.deleteConfirm.replace('{route}', routeName(route)))) return;
  await mutateRoute(`/api/routes/${encodeURIComponent(subdomain)}`, { method: 'DELETE' }, ui.routeDeleted, () => {
    if (document.getElementById('f-original-subdomain').value === subdomain) resetRouteForm();
  });
}

document.querySelector('form').addEventListener('input', clearFailedMutation);
document.querySelector('form').addEventListener('change', clearFailedMutation);
document.getElementById('route-list').addEventListener('click', event => {
  const button = event.target.closest('button[data-action]');
  if (!button) return;
  ({ edit: editRoute, toggle: toggleRouteDisabled, delete: deleteRoute })[button.dataset.action]?.(button.dataset.subdomain);
});
document.querySelectorAll('input[name="route_mode"]').forEach(input => input.addEventListener('change', toggleRouteTypeFields));

renderRoutes();
document.querySelectorAll('input[name="auth_mode"]').forEach((input) => {
  input.addEventListener('change', toggleAuthModeFields);
});
toggleAuthModeFields();
toggleRouteTypeFields();
loadTunnelStatus();
</script>
</body>
</html>
