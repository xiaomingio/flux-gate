<script>
const baseDomain = <%- JSON.stringify(baseDomain).replace(/</g, '\\u003c') %>;
const ui = <%- JSON.stringify(ui).replace(/</g, '\\u003c') %>;
const csrfToken = <%- JSON.stringify(csrfToken).replace(/</g, '\\u003c') %>;
const routes = <%- JSON.stringify(routes).replace(/</g, '\\u003c') %>;
let mutationPending = false;
let tunnelState = null;
let unconfirmedOperation = null;
let failedMutation = null;
let operationContext = null;

function managementFetch(url, options = {}) {
  const method = (options.method || 'GET').toUpperCase();
  return fetch(url, { ...options, headers: { ...options.headers, ...(!['GET', 'HEAD'].includes(method) ? { 'X-CSRF-Token': csrfToken } : {}) } });
}

function renderTunnelStatus() {
  const state = tunnelState;
  const status = mutationPending ? ui.routeSaving : !state ? ui.tunnelLoading : ({ disabled: ui.tunnelManual, pending: ui.tunnelPending, applied: ui.tunnelApplied, error: ui.tunnelError })[state.status] || ui.tunnelError;
  const primary = state?.inventories?.find(inventory => inventory.kind === 'forwarding');
  document.getElementById('tunnel-panel').innerHTML = `<div class="flex flex-wrap items-center justify-between gap-3"><span class="text-sm ${state?.status === 'error' ? 'text-red-700' : state?.status === 'applied' ? 'text-emerald-700' : 'text-slate-500'}">${escapeHtml(status)}</span><button type="button" id="tunnel-refresh-button" class="min-h-11 rounded-lg px-3 py-2 text-sm text-slate-500 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500">${ui.refreshStatus}</button></div>${primary?.existing_rules_error || state?.error ? `<p class="mt-2 break-words text-sm text-red-700">${escapeHtml(primary?.existing_rules_error || state.error)}</p>` : ''}`;
  document.getElementById('tunnel-refresh-button').addEventListener('click', refreshPublicationStatus);
}

async function loadTunnelStatus() {
  try {
    const response = await managementFetch('/api/tunnel');
    if (!response.ok) throw new Error(response.status === 401 ? ui.relogin : ui.tunnelLoadFailed);
    const data = await response.json();
    if (typeof data.enabled !== 'boolean' || !Array.isArray(data.rules)) throw new Error(ui.tunnelLoadFailed);
    tunnelState = data;
  } catch (error) { tunnelState = { enabled: false, status: 'error', rules: [], error: error.message || ui.tunnelLoadFailed }; }
  renderTunnelStatus();
  renderRoutes();
}

function acceptPublication(data) {
  if (Array.isArray(data.routes)) routes.splice(0, routes.length, ...data.routes);
  if (data.tunnel && typeof data.tunnel.enabled === 'boolean') tunnelState = data.tunnel;
  renderRoutes();
  renderTunnelStatus();
  setMutationPending(mutationPending);
}

async function readPublication() {
  const [routeResponse, tunnelResponse] = await Promise.all([managementFetch('/api/routes', { cache: 'no-store' }), managementFetch('/api/tunnel', { cache: 'no-store' })]);
  if (routeResponse.status === 401 || tunnelResponse.status === 401) throw new Error(ui.relogin);
  if (!routeResponse.ok || !tunnelResponse.ok) throw new Error(ui.routeLoadFailed);
  const [routeData, tunnelData] = await Promise.all([routeResponse.json(), tunnelResponse.json()]);
  if (!Array.isArray(routeData) || typeof tunnelData.enabled !== 'boolean') throw new Error(ui.routeLoadFailed);
  acceptPublication({ routes: routeData, tunnel: tunnelData });
}

async function readOperation(id) {
  const response = await managementFetch(`/api/operations/${encodeURIComponent(id)}`, { cache: 'no-store' });
  if (response.status === 401) throw new Error(ui.relogin);
  if (response.status === 404) return null;
  if (!response.ok) throw new Error(ui.syncUnconfirmed);
  const data = await response.json();
  return data.operation?.id === id ? data.operation : null;
}

function checkOperation(operation) {
  if (operation?.status === 'applied' && operation.current === true) return;
  const message = !operation ? ui.syncUnconfirmed
    : operation.status === 'local_only' ? ui.syncLocalOnly
    : operation.status === 'rolled_back' ? ui.syncRolledBack
    : operation.status === 'applied' && operation.current !== true ? ui.syncSuperseded
    : operation.error || ui.syncUnconfirmed;
  throw Object.assign(new Error(message), { operation });
}

async function recoverOperation(id, complete, snapshot) {
  unconfirmedOperation = { id, complete, snapshot };
  showRouteMessage(ui.syncChecking);
  for (const delay of [0, 500, 1000, 2000, 3000, 3000]) {
    if (delay) await new Promise(resolve => setTimeout(resolve, delay));
    let operation;
    try { operation = await readOperation(id); } catch { continue; }
    if (!operation || ['queued', 'running'].includes(operation.status)) continue;
    try { await readPublication(); } catch {
      unconfirmedOperation = { id, complete, snapshot };
      throw new Error(ui.syncUnconfirmed);
    }
    if (operation.status === 'unknown') unconfirmedOperation = { id, complete, snapshot };
    checkOperation(operation);
    unconfirmedOperation = null;
    return;
  }
  unconfirmedOperation = { id, complete, snapshot };
  throw new Error(ui.syncUnconfirmed);
}

async function refreshPublicationStatus() {
  const button = document.getElementById('tunnel-refresh-button');
  button.disabled = true;
  const pending = unconfirmedOperation;
  operationContext = pending?.snapshot?.context || { kind: 'business' };
  try {
    await readPublication();
    if (pending) {
      const operation = await readOperation(pending.id);
      if (!operation || ['queued', 'running', 'unknown'].includes(operation.status)) throw new Error(ui.syncUnconfirmed);
      unconfirmedOperation = null;
      checkOperation(operation);
      pending.complete();
    }
  } catch (error) { showMutationFailure(error, pending?.snapshot); }
  finally { setMutationPending(Boolean(unconfirmedOperation)); }
}

function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
}

function selectedMode() { return document.querySelector('input[name="route_mode"]:checked').value; }
function formRouteType() { return selectedMode() === 'tcp-direct' ? 'tcp' : 'http'; }

function routeType(route) { return route.type === 'tcp' ? 'tcp' : 'http'; }
function routeName(route) { return `${route.subdomain}.${baseDomain}`; }

function formatPublicAddress(hostname, service, managed = false) {
  if (!hostname) return ui.catchAllRule;
  const host = String(hostname).replace(/^(?:https?|tcp|ssh):\/\//i, '');
  let scheme = /^https?:\/\//i.test(service || '') ? 'https' : /^(?:tcp|ssh):\/\//i.test(service || '') ? 'tcp' : null;
  if (!scheme && managed) {
    const route = routes.find(route => routeName(route) === host);
    if (route) scheme = routeType(route) === 'tcp' ? 'tcp' : 'https';
  }
  if (scheme) return `${scheme}://${host}`;
  return service === 'http_status:404' ? `${ui.pathBlocked} · ${host}` : host;
}

function showRouteMessage(message, error = false, action) {
  const row = operationContext?.subdomain ? [...document.querySelectorAll('[data-route-subdomain]')].find(row => row.dataset.routeSubdomain === operationContext.subdomain) : null;
  const target = row?.querySelector('[data-route-feedback]') || (operationContext?.kind === 'form' && document.getElementById('route-modal').open ? document.getElementById('form-msg') : document.getElementById('route-feedback'));
  const box = document.createElement('div');
  box.className = error
    ? 'rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700'
    : 'rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700';
  box.textContent = message;
  if (action) {
    const button = document.createElement('button');
    button.id = 'mutation-recovery-button';
    button.type = 'button';
    button.className = 'mt-3 block rounded-lg border border-current px-3 py-2 font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-400';
    button.textContent = action.label;
    button.addEventListener('click', action.run);
    box.appendChild(button);
  }
  target.replaceChildren(box);
  if (error) box.scrollIntoView({ block: 'nearest' });
}

function clearFailedMutation() {
  failedMutation = null;
  if (!unconfirmedOperation) document.getElementById('mutation-recovery-button')?.remove();
}

function showMutationFailure(error, snapshot) {
  const retryable = error.operation?.status === 'rolled_back' && error.operation.rollback_confirmed === true && snapshot;
  if (retryable) {
    failedMutation = snapshot;
    document.getElementById('route-cancel-button').classList.remove('hidden');
    showRouteMessage(ui.syncRolledBack, true, { label: ui.retryOperation, run: () => {
      if (!failedMutation || mutationPending) return;
      const retry = failedMutation;
      mutateRoute(retry.url, retry.options, retry.successMessage, retry.onSuccess, retry.context);
    } });
  } else if (unconfirmedOperation) {
    showRouteMessage(ui.syncUnconfirmed, true, { label: ui.verifyOperation, run: refreshPublicationStatus });
  } else { showRouteMessage(error.message || ui.routeRequestFailed, true); }
}

async function mutateRoute(url, options, successMessage, onSuccess = () => {}, context = { kind: 'business' }) {
  operationContext = context;
  const id = crypto.randomUUID();
  const snapshot = { url, options, successMessage, onSuccess, context };
  clearFailedMutation();
  const complete = () => { clearFailedMutation(); onSuccess(); showRouteMessage(successMessage); };
  setMutationPending(true);
  renderTunnelStatus();
  setMutationPending(true);
  showRouteMessage(ui.routeSyncing);
  try {
    let response, data;
    try {
      response = await managementFetch(url, { ...options, headers: { ...options.headers, 'X-Flux-Gate-Operation': id } });
      data = await response.json();
    } catch {
      await recoverOperation(id, complete, snapshot);
      complete();
      return;
    }
    if (response.status >= 500 && !data.operation) {
      await recoverOperation(id, complete, snapshot);
      complete();
      return;
    }
    acceptPublication(data);
    if (response.status === 401) throw new Error(ui.relogin);
    if (!response.ok || data.error) {
      if (data.operation?.status === 'unknown') unconfirmedOperation = { id, complete, snapshot };
      throw Object.assign(new Error(data.error || ui.routeRequestFailed), { operation: data.operation });
    }
    if (data.operation?.id !== id) {
      await recoverOperation(id, complete, snapshot);
      complete();
      return;
    }
    checkOperation(data.operation);
    complete();
  } catch (error) { showMutationFailure(error, snapshot); }
  finally {
    setMutationPending(Boolean(unconfirmedOperation));
    renderTunnelStatus();
  }
}

function setMutationPending(pending) {
  mutationPending = pending;
  document.querySelectorAll('#route-list button, #route-add, #route-submit-button, #route-cancel-button').forEach(button => { button.disabled = pending; });
  const submit = document.getElementById('route-submit-button');
  document.getElementById('route-form').inert = pending && operationContext?.kind === 'form';
  submit.setAttribute('aria-busy', String(pending && operationContext?.kind === 'form'));
  submit.textContent = pending && operationContext?.kind === 'form' ? ui.routeSaving : document.getElementById('f-original-subdomain').value ? ui.update : ui.add;
  const refresh = document.getElementById('tunnel-refresh-button');
  if (refresh) refresh.disabled = pending && !unconfirmedOperation;
}

function toggleRouteTypeFields() {
  const tcp = formRouteType() === 'tcp';
  document.getElementById('f-sub-scheme').textContent = tcp ? 'tcp://' : 'https://';
  document.getElementById('f-sub').placeholder = tcp ? 'ssh' : 'nas';
  document.getElementById('f-target-scheme').textContent = tcp ? 'tcp://' : 'http://';
  const protectedMode = selectedMode() === 'protected';
  document.getElementById('http-auth-fields').classList.toggle('hidden', !protectedMode);
  document.getElementById('http-auth-fields').disabled = !protectedMode;
  document.getElementById('cloudflare-access-note').textContent = tcp ? ui.cloudflareTcp : ui.cloudflareHttp;
  toggleAuthModeFields();
}

function getRouteStatusLabel(route) {
  if (route.current_verified && route.current_path === 'blocked' && route.desired_path === 'blocked') return ui.routeDisabledState;
  return ({ applied: ui.publicationApplied, pending: ui.tunnelPending, disabled: ui.tunnelManual, error: ui.tunnelError })[route.publication_status] || ui.currentUnknown;
}

function getRouteStatusClass(route) {
  if (route.publication_status === 'pending') return 'border-amber-200 bg-amber-50 text-amber-700';
  if (route.publication_status === 'error') return 'border-red-200 bg-red-50 text-red-700';
  if (route.current_verified && route.current_path === 'blocked') return 'border-slate-300 bg-slate-100 text-slate-600';
  return route.current_verified ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-slate-300 bg-slate-100 text-slate-600';
}

function pathLabel(path) {
  return ({ gateway: ui.pathGateway, direct: ui.pathDirect, blocked: ui.pathBlocked, unmanaged: ui.pathUnmanaged, unknown: ui.currentUnknown })[path] || ui.currentUnknown;
}

function renderWebAddress(value) {
  const label = escapeHtml(value);
  try {
    const url = new URL(value);
    if (['http:', 'https:'].includes(url.protocol)) return `<a href="${escapeHtml(url.href)}" target="_blank" rel="noopener noreferrer" class="break-all underline decoration-slate-300 underline-offset-2 hover:text-sky-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500">${label}</a>`;
  } catch {}
  return label;
}

function renderRoutePath(route) {
  const current = route.current_verified ? route.current_path : 'unknown';
  const source = renderWebAddress(formatPublicAddress(routeName(route), route.target_service, true));
  const nodes = [source];
  if (current === 'gateway' || current === 'direct') {
    const gatewayActive = current === 'gateway' && route.desired_path === 'gateway';
    const service = current === 'direct' ? route.current_service : gatewayActive ? route.target_service : ui.pathBlocked;
    nodes.push('Cloudflare', 'Cloudflare Tunnel');
    if (current === 'gateway') nodes.push(`FluxGate${gatewayActive ? ` (${escapeHtml(ui.basicAuthProtection)})` : ''}`);
    nodes.push(renderWebAddress(service));
  } else if (current === 'blocked') {
    nodes.push('Cloudflare', 'Cloudflare Tunnel', `<span class="rounded border border-red-200 bg-red-50 px-2 py-0.5 text-red-700">${escapeHtml(ui.pathBlocked)}</span>`);
    if (routeType(route) === 'http' && !route.no_password) nodes.push(`FluxGate (${escapeHtml(ui.basicAuthProtection)})`);
    nodes.push(renderWebAddress(route.target_service));
  } else {
    nodes.push(escapeHtml(pathLabel(current)));
    if (current === 'unmanaged' && route.current_service) nodes.push(renderWebAddress(route.current_service));
  }
  const arrow = '<span aria-hidden="true" class="text-slate-400"><span class="lg:hidden">↓</span><span class="hidden lg:inline">→</span></span>';
  const chain = nodes.map((node, index) => `<span class="inline-flex min-w-0 max-w-full items-start gap-x-1.5">${index ? arrow : ''}<span class="min-w-0 break-all">${node}</span></span>`).join('');
  const pending = route.publication_status === 'pending' || route.publication_status === 'error';
  const desired = route.desired_path === 'blocked' ? ui.blockPublicAccess : `${pathLabel(route.desired_path)} → ${route.target_service}`;
  return `<div class="min-w-0"><div aria-label="${escapeHtml(ui.currentPath)}" class="flex min-w-0 flex-col items-start gap-x-1.5 gap-y-1 lg:flex-row lg:flex-wrap lg:items-center text-sm leading-5 text-slate-700">${chain}</div>${pending ? `<div class="mt-2 border-t border-slate-200 pt-2 text-sm"><p class="break-all text-amber-700">${ui.desiredPath}: ${escapeHtml(desired)}</p>${current === 'direct' && route.desired_path === 'gateway' ? `<p class="mt-1 text-red-700">${ui.notProtectedYet}</p>` : ''}</div>` : ''}</div>`;
}

function toggleAuthModeFields() {
  const tcp = formRouteType() === 'tcp';
  const mode = document.querySelector('input[name="auth_mode"]:checked')?.value || 'default';
  document.getElementById('custom-auth-fields').classList.toggle('hidden', mode !== 'custom');
  const custom = selectedMode() === 'protected' && mode === 'custom';
  for (const id of ['f-username', 'f-password']) {
    document.getElementById(id).required = custom;
    document.getElementById(id).disabled = !custom;
  }
  document.getElementById('no-password-warning').classList.toggle('hidden', selectedMode() !== 'http-direct');
  document.getElementById('tcp-security-warning').classList.toggle('hidden', !tcp);
}

function icon(name) {
  const cls = 'h-4 w-4';
  const icons = {
    edit: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="${cls}" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 1 1 3.182 3.182L8.25 18.463 4.5 19.5l1.037-3.75L16.862 3.487Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 5.25 18.75 9" /></svg>`,
    play: `<svg viewBox="0 0 24 24" fill="currentColor" class="${cls}" aria-hidden="true"><path d="M8.25 6.75v10.5a.75.75 0 0 0 1.154.636l8.25-5.25a.75.75 0 0 0 0-1.272l-8.25-5.25A.75.75 0 0 0 8.25 6.75Z" /></svg>`,
    pause: `<svg viewBox="0 0 24 24" fill="currentColor" class="${cls}" aria-hidden="true"><path d="M6.75 5.25A.75.75 0 0 1 7.5 4.5h2.25a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H7.5a.75.75 0 0 1-.75-.75V5.25Zm6.75 0a.75.75 0 0 1 .75-.75h2.25a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1-.75-.75V5.25Z" /></svg>`,
    trash: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="${cls}" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h12" /><path stroke-linecap="round" stroke-linejoin="round" d="m9.75 7.5.375-1.5A1.125 1.125 0 0 1 11.214 5.25h1.572c.516 0 .966.35 1.089.85l.375 1.4" /><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5v9.75A2.25 2.25 0 0 0 10.5 19.5h3A2.25 2.25 0 0 0 15.75 17.25V7.5" /></svg>`,
  };
  return icons[name] || '';
}

function renderReadOnlyRule(rule, management = false) {
  return `<article class="grid min-w-0 gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 lg:grid-cols-[minmax(16rem,0.95fr)_minmax(0,1.4fr)_auto] lg:items-center lg:gap-x-4"><h3 class="min-w-0 break-all text-sm font-semibold text-slate-800">${renderWebAddress(formatPublicAddress(rule.hostname, rule.service, rule.managed && !management))}</h3><div class="min-w-0 text-sm leading-5 text-slate-600"><p class="break-all">→ ${renderWebAddress(rule.service)}</p>${rule.path ? `<p class="mt-0.5 break-all font-mono text-xs text-slate-500">${ui.rulePath}: ${escapeHtml(rule.path)}</p>` : ''}</div><span class="w-fit rounded bg-slate-100 px-2 py-1 text-xs text-slate-500">${rule.managed && !management ? ui.gateManaged : ui.externallyMaintained}</span></article>`;
}

function renderManagedRoute(route) {
  const name = routeName(route);
  const title = escapeHtml(route.description?.trim() || ui.untitledRoute);
  const buttons = [{ action: 'edit', label: ui.editLabel, glyph: 'edit' }, { action: 'toggle', label: route.disabled ? ui.enableLabel : ui.disableLabel, glyph: route.disabled ? 'play' : 'pause' }, { action: 'delete', label: ui.deleteLabel, glyph: 'trash' }];
  return `<article data-route-subdomain="${escapeHtml(route.subdomain)}" class="relative min-w-0 rounded-lg border border-slate-200 px-3 py-2.5 ${route.disabled ? 'bg-slate-100 opacity-70' : 'bg-white'}"><div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2 lg:min-h-11 lg:pr-40"><h3 class="min-w-0 break-words text-sm font-semibold text-slate-900">${title}</h3><div class="flex flex-wrap gap-1.5 text-xs"><span class="rounded bg-slate-100 px-2 py-0.5 text-slate-600">${routeType(route) === 'tcp' ? 'TCP' : 'HTTP'} · ${routeType(route) === 'http' && !route.no_password ? ui.passwordProtection : ui.directConnection}</span><span class="rounded border px-2 py-0.5 ${getRouteStatusClass(route)}">${escapeHtml(getRouteStatusLabel(route))}</span></div></div><div class="mt-2 lg:mt-1.5">${renderRoutePath(route)}</div><div class="mt-3 flex shrink-0 gap-1 lg:absolute lg:right-3 lg:top-2.5 lg:mt-0">${buttons.map(button => `<button type="button" data-action="${button.action}" data-subdomain="${escapeHtml(route.subdomain)}" title="${escapeHtml(button.label)}" aria-label="${escapeHtml(button.label)} ${escapeHtml(name)}" class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500 disabled:opacity-40">${icon(button.glyph)}</button>`).join('')}</div><div data-route-feedback role="status" aria-live="polite" class="mt-2 empty:hidden"></div></article>`;
}

function renderRoutes() {
  const primary = tunnelState?.inventories?.find(inventory => inventory.kind === 'forwarding');
  const seen = new Set();
  const entries = (primary?.existing_rules || []).map(rule => {
    const route = rule.managed && !primary.read_only && !rule.path ? routes.find(route => routeName(route) === rule.hostname) : null;
    if (route) { seen.add(route.subdomain); return renderManagedRoute(route); }
    return renderReadOnlyRule(rule);
  });
  for (const route of routes) if (!seen.has(route.subdomain)) entries.push(renderManagedRoute(route));
  document.getElementById('route-list').innerHTML = entries.length ? `<div class="grid min-w-0 gap-2">${entries.join('')}</div>` : `<p class="py-5 text-sm text-slate-500">${ui.emptyRoutes}</p>`;
  const management = tunnelState?.inventories?.filter(inventory => inventory.kind === 'management') || [];
  document.getElementById('management-status').textContent = !tunnelState ? ui.tunnelLoading : management.some(inventory => inventory.existing_rules_error) ? management.map(inventory => inventory.existing_rules_error).filter(Boolean).join(' ') : management.every(inventory => inventory.current_verified) && management.length ? ui.configurationVerified : ui.configurationUnverified;
  document.getElementById('management-rules').innerHTML = `<div class="grid min-w-0 gap-2">${management.flatMap(inventory => inventory.existing_rules || []).map(rule => renderReadOnlyRule(rule, true)).join('') || `<p class="py-3 text-sm text-slate-500">${ui.noExistingRules}</p>`}</div>`;
  setMutationPending(mutationPending);
}

function openModal(id, trigger) {
  const modal = document.getElementById(id);
  modal.returnFocusTarget = trigger || document.activeElement;
  modal.showModal();
  modal.querySelector('[data-scroll-region]')?.scrollTo(0, 0);
  document.documentElement.classList.add('modal-open');
}

function openRouteModal(trigger) {
  if (mutationPending) return;
  resetRouteForm();
  operationContext = { kind: 'form' };
  document.getElementById('form-msg').replaceChildren();
  openModal('route-modal', trigger);
  document.getElementById('f-sub').focus();
}

function closeRouteModal() {
  if (mutationPending && operationContext?.kind === 'form') return;
  document.getElementById('route-modal').close();
}

function openSettingsModal(trigger) {
  openModal('settings-modal', trigger);
  document.getElementById('settings-current').focus();
}

function defaultRouteName(subdomain) {
  return subdomain.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().replace(/\b[a-z0-9]/g, letter => letter.toUpperCase());
}

function syncAutomaticName() {
  document.getElementById('f-desc').value = defaultRouteName(document.getElementById('f-sub').value);
}

function resetRouteForm() {
  clearFailedMutation();
  document.getElementById('f-mode-protected').checked = true;
  document.getElementById('f-original-subdomain').value = '';
  document.getElementById('f-sub').value = '';
  document.getElementById('f-ip').value = '';
  document.getElementById('f-port').value = '';
  document.getElementById('f-desc').value = '';
  document.getElementById('f-username').value = '';
  document.getElementById('f-password').value = '';
  document.getElementById('auth-mode-default').checked = true;
  document.getElementById('f-enabled').checked = true;
  toggleAuthModeFields();
  toggleRouteTypeFields();
  document.getElementById('route-form-title').textContent = ui.addRoute;
  document.getElementById('route-form-subtitle').textContent = ui.addPanelDescription;
  document.getElementById('route-submit-button').textContent = ui.add;
  document.getElementById('route-cancel-button').classList.add('hidden');
}

function editRoute(subdomain) {
  if (mutationPending) return;
  operationContext = { kind: 'form' };
  openModal('route-modal', document.activeElement);
  clearFailedMutation();
  const route = routes.find((item) => item.subdomain === subdomain);
  if (!route) return;

  document.getElementById('f-original-subdomain').value = route.subdomain;
  document.getElementById(routeType(route) === 'tcp' ? 'f-mode-tcp-direct' : route.no_password ? 'f-mode-http-direct' : 'f-mode-protected').checked = true;
  document.getElementById('f-sub').value = route.subdomain;
  document.getElementById('f-ip').value = route.ip;
  document.getElementById('f-port').value = route.port;
  document.getElementById('f-desc').value = route.description || '';
  document.getElementById('f-username').value = route.username || '';
  document.getElementById('f-password').value = '';
  if (route.has_custom_auth) document.getElementById('auth-mode-custom').checked = true;
  else document.getElementById('auth-mode-default').checked = true;
  document.getElementById('f-enabled').checked = !Boolean(route.disabled);
  toggleAuthModeFields();
  toggleRouteTypeFields();
  document.getElementById('route-form-title').textContent = ui.updateRoute;
  document.getElementById('route-form-subtitle').textContent = ui.editingRoute.replace('{route}', `${route.subdomain}.${baseDomain}`);
  document.getElementById('route-submit-button').textContent = ui.update;
  document.getElementById('route-cancel-button').classList.remove('hidden');
  document.getElementById('f-sub').focus();
}

async function saveRoute(e) {
  e.preventDefault();
  operationContext = { kind: 'form' };
  if (mutationPending) return;
  const originalSubdomain = document.getElementById('f-original-subdomain').value.trim();
  const type = formRouteType();
  const disabled = !document.getElementById('f-enabled').checked;
  const previous = routes.find(route => route.subdomain === originalSubdomain);
  if (previous && !previous.disabled && disabled && !confirm(ui.disableConfirm.replace('{route}', routeName(previous)))) return;
  const input = {
    original_subdomain: originalSubdomain,
    subdomain: document.getElementById('f-sub').value.trim(),
    type,
    ip: document.getElementById('f-ip').value.trim(),
    port: Number(document.getElementById('f-port').value),
    description: document.getElementById('f-desc').value.trim(),
    disabled,
  };
  if (type === 'http') {
    const authMode = selectedMode() === 'http-direct' ? 'none' : document.querySelector('input[name="auth_mode"]:checked')?.value || 'default';
    input.auth_mode = authMode;
    input.username = authMode === 'custom' ? document.getElementById('f-username').value.trim() : '';
    input.password = authMode === 'custom' ? document.getElementById('f-password').value.trim() : '';
    if (authMode === 'custom' && (!input.username || !input.password)) {
      showRouteMessage(ui.customCredentialsRequired, true);
      document.getElementById(!input.username ? 'f-username' : 'f-password').focus();
      return;
    }
    input.no_password = authMode === 'none';
  }
  await mutateRoute('/api/routes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(input) }, originalSubdomain ? ui.routeSavedUpdated : ui.routeSavedAdded, () => { document.getElementById('route-modal').close(); }, { kind: 'form' });
}

async function toggleRouteDisabled(subdomain) {
  if (mutationPending) return;
  const route = routes.find(item => item.subdomain === subdomain);
  if (!route || (!route.disabled && !confirm(ui.disableConfirm.replace('{route}', routeName(route))))) return;
  await mutateRoute(`/api/routes/${encodeURIComponent(subdomain)}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ disabled: !route.disabled }) }, ui.routeSavedUpdated, undefined, { kind: 'route', subdomain });
}

async function deleteRoute(subdomain) {
  if (mutationPending) return;
  const route = routes.find(item => item.subdomain === subdomain);
  if (!route || !confirm(ui.deleteConfirm.replace('{route}', routeName(route)))) return;
  await mutateRoute(`/api/routes/${encodeURIComponent(subdomain)}`, { method: 'DELETE' }, ui.routeDeleted, () => {
    if (document.getElementById('f-original-subdomain').value === subdomain) resetRouteForm();
  }, { kind: 'route', subdomain });
}


for (const id of ['route-modal', 'settings-modal', 'logout-modal']) {
  const modal = document.getElementById(id);
  modal.addEventListener('cancel', event => { if (id === 'route-modal' && mutationPending && operationContext?.kind === 'form') event.preventDefault(); });
  modal.addEventListener('close', () => {
    if (!document.querySelector('dialog[open]')) document.documentElement.classList.remove('modal-open');
    if (id === 'route-modal') resetRouteForm();
    if (id === 'settings-modal') { document.getElementById('settings-form').reset(); document.getElementById('settings-msg').textContent = ''; }
    const target = modal.returnFocusTarget;
    if (target?.isConnected) target.focus(); else document.getElementById('route-add').focus();
  });
}

document.getElementById('settings-form').addEventListener('submit', async event => {
  event.preventDefault();
  const button = document.getElementById('settings-submit');
  if (button.disabled) return;
  button.disabled = true;
  button.textContent = ui.settingsSaving;
  document.getElementById('settings-msg').textContent = '';
  try {
    const data = Object.fromEntries(new FormData(event.currentTarget));
    const response = await managementFetch('/settings/password' + (ui.htmlLang === 'en' ? '?lang=en' : ''), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    if (response.status === 401 || response.redirected && new URL(response.url).pathname === '/login') throw new Error(ui.relogin);
    const result = await response.json();
    if (!response.ok || result.error) throw new Error(result.error || ui.settingsRequestFailed);
    location.assign(result.redirect || '/login');
  } catch (error) { document.getElementById('settings-msg').textContent = error.message || ui.settingsRequestFailed; }
  finally { button.disabled = false; button.textContent = ui.settingsSave; }
});
if (new URL(location.href).searchParams.get('settings') === 'open') openSettingsModal(document.getElementById('settings-open'));
document.getElementById('f-sub').addEventListener('input', syncAutomaticName);
document.getElementById('route-form').addEventListener('input', clearFailedMutation);
document.getElementById('route-form').addEventListener('change', clearFailedMutation);
document.getElementById('route-list').addEventListener('click', event => {
  const button = event.target.closest('button[data-action]');
  if (!button) return;
  ({ edit: editRoute, toggle: toggleRouteDisabled, delete: deleteRoute })[button.dataset.action]?.(button.dataset.subdomain);
});
document.querySelectorAll('input[name="route_mode"]').forEach(input => input.addEventListener('change', toggleRouteTypeFields));

renderRoutes();
document.querySelectorAll('input[name="auth_mode"]').forEach((input) => {
  input.addEventListener('change', toggleAuthModeFields);
});
toggleAuthModeFields();
toggleRouteTypeFields();
loadTunnelStatus();
</script>
</body>
</html>
