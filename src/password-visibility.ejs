<% /* 文件说明: 统一密码输入框的可见性切换、无障碍状态和表单重置时的隐藏状态。 */ %>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const showLabel = <%- JSON.stringify(ui.showPassword) %>;
    const hideLabel = <%- JSON.stringify(ui.hidePassword) %>;
    const eye = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>';
    const eyeOff = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="m3 3 18 18M10.6 5.1A11 11 0 0 1 12 5c6.5 0 10 7 10 7a20 20 0 0 1-3.1 3.9M6.2 6.2A20 20 0 0 0 2 12s3.5 7 10 7a11 11 0 0 0 5.8-1.8M10 10a3 3 0 0 0 4 4"/></svg>';
    for (const input of document.querySelectorAll('input[type="password"]')) {
      const wrapper = document.createElement('div');
      wrapper.className = 'relative min-w-0';
      input.before(wrapper);
      wrapper.append(input);
      input.classList.add('pr-12');
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.passwordToggle = input.id;
      button.className = 'absolute right-1 top-1/2 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500';
      function update(visible) {
        input.type = visible ? 'text' : 'password';
        button.setAttribute('aria-label', visible ? hideLabel : showLabel);
        button.title = visible ? hideLabel : showLabel;
        button.setAttribute('aria-pressed', String(visible));
        button.innerHTML = visible ? eyeOff : eye;
      }
      button.addEventListener('click', () => update(input.type === 'password'));
      input.form?.addEventListener('reset', () => update(false));
      input.closest('dialog')?.addEventListener('close', () => update(false));
      update(false);
      wrapper.append(button);
    }
  });
</script>
