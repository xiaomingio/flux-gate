<% /* 文件说明: 提供支持鼠标、触屏和键盘的中英文悬浮选择菜单。 */ %>
<div id="language-control" class="relative">
  <button id="language-toggle" type="button" title="<%= ui.language %>" aria-label="<%= ui.language %>" aria-haspopup="true" aria-expanded="false" aria-controls="language-options" class="inline-flex h-10 w-10 sm:h-9 sm:w-9 items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"><%- include('icons.ejs', { name: 'globe' }) %></button>
  <div id="language-options" hidden class="absolute right-0 top-full z-50 min-w-36 rounded-xl border border-slate-200 bg-white p-1.5 shadow-xl shadow-slate-900/10">
    <a data-language="zh" href="<%= lang === 'zh' ? '#' : languageSwitchHref %>" lang="zh-CN" <%- lang === 'zh' ? 'aria-current="true"' : '' %> class="block rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500">简体中文</a>
    <a data-language="en" href="<%= lang === 'en' ? '#' : languageSwitchHref %>" lang="en" <%- lang === 'en' ? 'aria-current="true"' : '' %> class="block rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky-500">English</a>
  </div>
</div>
<script>
  (() => {
    const control = document.getElementById('language-control');
    const toggle = document.getElementById('language-toggle');
    const options = document.getElementById('language-options');
    let timer;
    const show = open => { options.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); };
    options.querySelectorAll('a').forEach(link => { const url = new URL(location.href); url.searchParams.set('lang', link.dataset.language); link.href = url.pathname + url.search; });
    control.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { clearTimeout(timer); show(true); } });
    control.addEventListener('pointerleave', () => { timer = setTimeout(() => { if (!control.contains(document.activeElement)) show(false); }, 150); });
    toggle.addEventListener('click', () => { clearTimeout(timer); show(true); });
    toggle.addEventListener('keydown', event => { if (event.key === 'ArrowDown') { event.preventDefault(); show(true); options.querySelector('a').focus(); } });
    control.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); show(false); toggle.focus(); } });
    control.addEventListener('focusout', () => setTimeout(() => { if (!control.contains(document.activeElement)) show(false); }, 0));
    document.addEventListener('pointerdown', event => { if (!control.contains(event.target)) show(false); });
  })();
</script>
